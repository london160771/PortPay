NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Internal regression/dev use only. Production routes never select this adapter.
PORTPAY_ENABLE_INTERNAL_TESTNET=false
X_LAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech/terigon
X_LAYER_TESTNET_EXPLORER_URL=https://www.okx.com/web3/explorer/xlayer-test
# Verified against the current official OKX X Layer Testnet payment docs.
TESTNET_USDT0_ADDRESS=0x9e29b3aada05bf2d2c827af80bd28dc0b9b4fb0c
DEMO_AAPL_ADDRESS=0x756546fce7d7ca3bb4be127904b002baf13b432e
DEMO_NVDA_ADDRESS=0xa0c469d4419446c21a1d992c0a1c3cdc09bbcc4e
PORTPAY_SETTLEMENT_ADDRESS=0xeaab8d9507dcb3323c6045544d0bae546bfed90b
PORTPAY_BUILDER_CODE=kob1lkgsg6infkg3
DEMO_PRICE_SOURCE=demo-config
DEMO_AAPL_REFERENCE_PRICE_USD=250.00
DEMO_NVDA_REFERENCE_PRICE_USD=180.00
QUOTE_TTL_SECONDS=300
# Invoice reconciliation requires this many canonical block confirmations.
SETTLEMENT_CONFIRMATION_DEPTH=2

# X Layer Mainnet product/preparation path (chain ID 196). Values are isolated from testnet.
X_LAYER_MAINNET_RPC_URL=https://rpc.xlayer.tech
X_LAYER_MAINNET_EXPLORER_URL=https://www.okx.com/web3/explorer/xlayer
MAINNET_WNVDA_ADDRESS=0xa8ddb5cd96b5222afe198316e9a57caa642850d5
MAINNET_WAAPL_ADDRESS=0x943bf64d566c32a2bcd41ac92fb63c111cc9de8f
MAINNET_USDT0_ADDRESS=0x779ded0c9e1022225f8e0630b35a9b54be713736
PORTPAY_MAINNET_BUILDER_CODE=5fc2j7wx6trof4eu
PORTPAY_MAINNET_BUILDER_PAYOUT_ADDRESS=0xbabdfef588cf57efcc7c8857960e3ccdd9167589
MAINNET_QUOTE_TTL_SECONDS=60
# Mainnet receipt verification requires this many canonical confirmations.
MAINNET_CONFIRMATION_DEPTH=2
# Server-only OKX DEX V6 credentials. Never place these in frontend/.env files.
OKX_DEX_API_KEY=
OKX_DEX_SECRET_KEY=
OKX_DEX_PASSPHRASE=

# Server-only merchant integration credentials. Keep these out of browser code.
# Generate high-entropy values of at least 32 characters and configure them only on the backend.
PORTPAY_TEST_API_KEY=
PORTPAY_TEST_MERCHANT_ADDRESS=
PORTPAY_TEST_WEBHOOK_URL=
PORTPAY_TEST_WEBHOOK_SECRET=

# Server-only EIP-712 quote signer. Never expose or commit this private key.
QUOTE_SIGNER_PRIVATE_KEY=

# Supabase/Postgres runtime configuration. The backend uses the service-role key server-side.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
