NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# X Layer Testnet (chain ID 1952)
X_LAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech/terigon
X_LAYER_TESTNET_EXPLORER_URL=https://www.okx.com/web3/explorer/xlayer-test
# Verified against the current official OKX X Layer Testnet payment docs.
TESTNET_USDT0_ADDRESS=0x9e29b3aada05bf2d2c827af80bd28dc0b9b4fb0c
DEMO_AAPL_ADDRESS=
DEMO_NVDA_ADDRESS=
PORTPAY_SETTLEMENT_ADDRESS=
PORTPAY_BUILDER_CODE=
DEMO_PRICE_SOURCE=demo-config
DEMO_AAPL_REFERENCE_PRICE_USD=250.00
QUOTE_TTL_SECONDS=300
# Invoice reconciliation requires this many canonical block confirmations.
SETTLEMENT_CONFIRMATION_DEPTH=2

# Server-only EIP-712 quote signer. Never expose or commit this private key.
QUOTE_SIGNER_PRIVATE_KEY=

# Supabase/Postgres runtime configuration. The backend uses the service-role key server-side.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
